{
  "name": "openfox-semantic-tools",
  "version": "0.0.1",
  "description": "Provider-agnostic semantic decision tools for OpenFox using Jev/System One-compatible endpoints.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "docs"
  ],
  "openfox": {
    "apiVersion": 2,
    "entry": "./dist/index.js",
    "displayName": "Semantic Tools",
    "description": "Fast typed semantic decisions for OpenFox workflows, with hosted or local System One-compatible providers.",
    "capabilities": [
      "settings",
      "tools",
      "skills"
    ],
    "timeoutMs": 125000
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:tests": "tsc -p tsconfig.tests.json",
    "test": "node --import tsx --test test/**/*.test.ts",
    "check": "npm run typecheck && npm run typecheck:tests && npm test && npm run build",
    "evaluate": "node --import tsx scripts/evaluate.ts",
    "prepack": "npm run build",
    "conformance": "node --import tsx scripts/conformance.ts",
    "conformance:smoke": "node --import tsx scripts/conformance-smoke.ts",
    "verify:experiment": "node --import tsx scripts/verify-experiment.ts"
  },
  "peerDependencies": {
    "openfox": ">=2.0.157"
  },
  "peerDependenciesMeta": {
    "openfox": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=24"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/theshwal/openfox-semantic-tools.git"
  }
}
