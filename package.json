{
  "name": "openfox-semantic-tools",
  "version": "0.2.0",
  "description": "Provider-agnostic semantic decision tools for OpenFox using Jev/System One-compatible endpoints.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "docs"
  ],
  "openfox": {
    "apiVersion": 2,
    "entry": "./dist/index.js",
    "compatibilityBaseline": "2.0.161",
    "displayName": "Semantic Tools",
    "description": "Fast typed semantic decisions for OpenFox workflows, with hosted or local System One-compatible providers.",
    "author": "theshwal",
    "icon": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#3b82f6\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M8 12h3l2-4 2 8 2-4h1\"/></svg>",
    "capabilities": [
      "settings",
      "tools",
      "skills",
      "transforms"
    ],
    "timeoutMs": 125000
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:tests": "tsc -p tsconfig.tests.json",
    "test": "node --import tsx --test test/**/*.test.ts",
    "check": "npm run typecheck && npm run typecheck:tests && npm test && npm run build",
    "evaluate": "node --import tsx scripts/evaluate.ts",
    "prepack": "npm run build",
    "conformance": "node --import tsx scripts/conformance.ts",
    "conformance:smoke": "node --import tsx scripts/conformance-smoke.ts",
    "verify:experiment": "node --import tsx scripts/verify-experiment.ts",
    "verify:replay": "node --import tsx scripts/verify-policy-replay.ts",
    "harness": "node --import tsx scripts/openfox-harness.ts",
    "harness:agent-e2e": "node --import tsx scripts/agent-e2e.ts",
    "workflow:install": "node dist/workflow/emit.js",
    "visual:spike": "node --import tsx scripts/visual-spike.ts",
    "transform:benchmark": "node --import tsx scripts/transform-benchmark.ts",
    "verify:local": "node --import tsx scripts/verify-local.ts"
  },
  "peerDependencies": {
    "openfox": ">=2.0.161"
  },
  "peerDependenciesMeta": {
    "openfox": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=24"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/theshwal/openfox-semantic-tools.git"
  },
  "bin": {
    "openfox-semantic-workflow": "./dist/workflow/emit.js"
  }
}
